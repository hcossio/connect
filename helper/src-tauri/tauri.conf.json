{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevAssist Helper",
  "version": "0.1.0",
  "identifier": "app.devassist.helper",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DevAssist Helper",
        "width": 360,
        "height": 230,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
